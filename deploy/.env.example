# 佛光山幹部改選投票系統 — 部署環境變數
#
# 用法：複製為 .env 後修改（docker compose 會自動讀取同目錄的 .env）
#   cp deploy/.env.example .env
#   ⚠️ 一定要改 POSTGRES_PASSWORD / REDIS_PASSWORD / JWT_SECRET

# ── 對外連接埠（只在「區網模式」docker-compose.yml 用到）─────────
# 若和其他服務衝突就改這兩個數字
VOTER_PORT=8080
ADMIN_PORT=8081

# ── 對外網域（只在「HTTPS 模式」docker-compose.prod.yml 用到）────
# 需要遠端投票時才填。這三個變數沒填，HTTPS 模式會拒絕啟動（避免誤用預設值）。
# VOTER_DOMAIN / ADMIN_DOMAIN 的 DNS A 記錄都要指向主機的對外 IP。
VOTER_DOMAIN=vote.example.com
ADMIN_DOMAIN=admin.vote.example.com
# Let's Encrypt 憑證到期通知收件人
ACME_EMAIL=you@example.com

# ── PostgreSQL ───────────────────────────────────────────────────
# ⚠️ 後端是讀「個別欄位」（DB_HOST/DB_USER/…）而非 DATABASE_URL，
#    這裡的 DB_* 會直接傳給 api 容器；POSTGRES_* 給資料庫容器初始化用。
POSTGRES_DB=fgs_vote
POSTGRES_USER=fgs_app
POSTGRES_PASSWORD=請改成強密碼
DB_NAME=fgs_vote
DB_USER=fgs_app
DB_PASSWORD=請改成與上面 POSTGRES_PASSWORD 相同
DB_HOST=db
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=請改成強密碼
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT（投票憑證簽章）──────────────────────────────────────────
# 至少 32 字元；可用 `openssl rand -hex 32` 產生
JWT_SECRET=請改成至少32字元的隨機字串
JWT_EXPIRE_MINUTES=1440
VOTER_TOKEN_EXPIRE_HOURS=12

# ── 應用 ─────────────────────────────────────────────────────────
# 正式上線請保持 false（true 會印出所有 SQL）
DEBUG=false
LOG_LEVEL=INFO

# 時區（影響匯出檔的時間與投票視窗判斷）
TZ=America/Toronto
