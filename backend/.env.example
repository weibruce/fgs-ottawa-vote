# 佛光山投票系統 — 環境變量模板（複製為 .env 並填入真實值）
DATABASE_URL=postgresql+psycopg2://fgs_app:CHANGE_ME@127.0.0.1:5432/fgs_vote
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
JWT_SECRET=CHANGE_ME_32CHARS_MIN
JWT_EXPIRE_MINUTES=1440
VOTER_TOKEN_EXPIRE_HOURS=12
API_PREFIX=/api
DEBUG=true
LOG_LEVEL=INFO

# 候選人照片上傳目錄（相對於啟動時的工作目錄，或用絕對路徑）
# 容器內 WORKDIR 是 /app，所以 ./uploads 就等於 /app/uploads（對應 compose 的 volume）
UPLOAD_DIR=./uploads
